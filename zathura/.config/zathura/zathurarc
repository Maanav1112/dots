### Settings from original zathurarc ###
set selection-clipboard clipboard
set sandbox none
set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 1
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map p print
map g goto top
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down
map [fullscreen] D toggle_page_mode
map [fullscreen] r reload
map [fullscreen] R rotate
map [fullscreen] K zoom in
map [fullscreen] J zoom out
map [fullscreen] p print
map [fullscreen] g goto top

### zathura-pywal ###
# Allow recolor
set recolor 'true'

# Don't allow original hue when recoloring
set recolor-keephue 'false'

# Don't keep original image colors while recoloring
set recolor-reverse-video 'false'

# Command line completion entries
set completion-fg '#bfd5d5'
set completion-bg '#1b1e25'

# Command line completion group elements
set completion-group-fg '#7A9FA0'
set completion-group-bg '#1b1e25'

# Current command line completion element
set completion-highlight-fg '#1b1e25'
set completion-highlight-bg '#bfd5d5'

# Default foreground/background color
set default-bg rgba(27,30,37,1)

# Input bar
set inputbar-fg '#bfd5d5'
set inputbar-bg '#1b1e25'

# Notification
set notification-fg '#bfd5d5'
set notification-bg '#1b1e25'

# Error notification
set notification-error-fg '#bfd5d5'
set notification-error-bg '#6F8F92'

# Warning notification
set notification-warning-fg '#bfd5d5'
set notification-warning-bg '#6F8F92'

# Tab - TODO
# set tabbar-fg
# set tabbar-bg

# Focused tab - TODO
# set tabbar-focus-fg
# set tabbar-focus-bg

# Status bar
set statusbar-fg '#bfd5d5'
set statusbar-bg '#1b1e25'

# Highlighting parts of the document (e.g. show search results)
set highlight-color '#7A9FA0'
set highlight-active-color '#7A9FA0'

# Represent light/dark colors in recoloring mode
set recolor-lightcolor rgba(0,0,0,0)
set recolor-darkcolor '#bfd5d5'

# 'Loading...' text
set render-loading-fg '#bfd5d5'
set render-loading-bg '#1b1e25'

# Index mode
set index-fg '#bfd5d5'
set index-bg '#1b1e25'

# Selected element in index mode
set index-active-fg '#1b1e25'
set index-active-bg '#bfd5d5'